FROM golang:1.25-bookworm AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG BINARY_NAME=mavenrss-server

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_OPTIONS="--max-old-space-size=2048 --no-warnings"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
RUN apt-get install -y --no-install-recommends nodejs

WORKDIR /app

COPY go.mod go.sum ./
COPY third_party/sqlite-vec-go-bindings ./third_party/sqlite-vec-go-bindings
RUN go mod download

COPY frontend/package*.json ./frontend/
RUN cd frontend && npm install

COPY . .

RUN cd frontend && npm run build

RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -tags server -trimpath -buildvcs=false -ldflags="-w -s" -o /out/${BINARY_NAME} ./main-core.go

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /usr/sbin/nologin mavenrss

WORKDIR /app

RUN mkdir -p /app/data && chown -R mavenrss:mavenrss /app

COPY --from=builder /out/mavenrss-server ./mavenrss-server

USER mavenrss

EXPOSE 1234

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:1234/api/version || exit 1

CMD ["./mavenrss-server", "-host", "0.0.0.0", "-port", "1234"]
